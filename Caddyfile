{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	root * {$FRONTEND_ROOT:dist}
	encode zstd gzip

	# The frontend health probe does not depend on the API being available.
	handle /frontend-healthz/ {
		respond "ok" 200
	}

	# Django is deployed separately at api.roadsense.site.
	@backend path /api /api/* /media /media/* /_authenticated /_authenticated/* /django-admin /django-admin/* /static /static/* /health/ /healthz/ /livez/ /auth/ /logout/
	handle @backend {
		reverse_proxy {$API_UPSTREAM:https://api.roadsense.site} {
			header_up Host {upstream_hostport}
			header_up X-Forwarded-Host {upstream_hostport}
		}
	}

	# Missing bundles must return 404 instead of the React HTML shell.
	handle /assets/* {
		@existing file
		header @existing Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# React owns all page routes, including direct visits and hard refreshes.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
